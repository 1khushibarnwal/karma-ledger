PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/karmachain

# Optional but recommended: raises GitHub API rate limit from 60/hr to 5000/hr
# Create at https://github.com/settings/tokens (no scopes needed)
GITHUB_TOKEN=

# The backend's own wallet private key — signs score payloads so the smart
# contract can verify authenticity. Get this from Anvil's local node output
# (`anvil` in the project root prints 10 funded test accounts + private keys).
# NEVER use a real-funds wallet's key here, even for a hackathon.
SIGNER_PRIVATE_KEY=

# Filled in after you run `forge script script/Deploy.s.sol --broadcast`
CONTRACT_ADDRESS=
